TEAM_NAME=team17-internship-management
SERVICE_NAME=internship-management-integration
SERVICE_VERSION=0.1
PARTNER_TEAM=pod5-alumni-network
PARTNER_API_URL=https://alumni-network-integration.phyo2lay.workers.dev/api/integration/status
PARTNER_WEBHOOK_URL=https://alumni-network-integration.phyo2lay.workers.dev/api/webhooks/partner
# Our receiver uses a direct secret; Pod 5's receiver uses this secret as the HMAC-SHA256 key.
WEBHOOK_SECRET=
PARTNER_WEBHOOK_SECRET=
# Private operator token for creating demo events. Do not share with the partner.
INTEGRATION_ADMIN_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional direct PostgreSQL access for the protected, read-only activity page.
# Keep DATABASE_URL server-only. The Supabase root CA is bundled in certs/.
DATABASE_URL=
# Public placements catalogue. Local mode uses web/.data/placements (no remote writes).
# Run npm run placements:setup once before npm run dev.
# For hosted deployment: postgres + a server-only Supabase connection URL.
PLACEMENTS_DB_MODE=local
PLACEMENTS_DATABASE_URL=
# Must be the externally reachable frontend origin when handing over to Team 12.
PUBLIC_SITE_URL=http://127.0.0.1:3001
# Student Identity: request an Internship-specific service key privately.
IDENTITY_API_KEY=
IDENTITY_CLIENT_ID=
IDENTITY_SERVICE_CONFIRMED=false
# Own Internship authentication. Run npm run auth:setup for local setup.
AUTH_DB_MODE=local
BETTER_AUTH_URL=http://127.0.0.1:3001
BETTER_AUTH_SECRET=
# Deployment requires postgres, separate persistent auth database and migrations.
AUTH_DATABASE_URL=
